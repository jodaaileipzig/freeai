# ============================================================
# FreeAI Studio - API-Schlüssel (alle KOSTENLOS erhältlich!)
# ============================================================
# Kopiere diese Datei zu ".env" und trage deine Schlüssel ein.
# Du brauchst NICHT alle - nur die Anbieter, die du nutzen willst.

# --- Groq (sehr schnelle LLMs, kostenlos) ---
# Kostenlosen Key holen: https://console.groq.com/keys
GROQ_API_KEY=

# --- OpenRouter (viele kostenlose Modelle) ---
# Kostenlosen Key holen: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Google Gemini (kostenloses Kontingent) ---
# Kostenlosen Key holen: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- Hugging Face (Bildgenerierung, TTS, etc.) ---
# Kostenloses Token holen: https://huggingface.co/settings/tokens
HF_API_KEY=
